# HydroGrow Local Edition. Copy to local-edition/.env and edit. Never commit .env.
#
# Laptop: the backend reads local-edition/.env; ingest, fake_pi.py and replay.py use
#         the defaults below unless you export the variables.
# Pi:     setup.sh renders this file into /etc/hydrogrow/hydrogrow.env with Pi values
#         (data dir, database path, 30 s sensor interval, pumps in dry run) and every
#         systemd unit reads it via EnvironmentFile=. No quotes, no shell expansion.

# ---- MQTT broker (Mosquitto on the Pi, tools/dev_broker.js on a laptop) ----
# If 1883 is taken on a laptop, set MQTT_PORT=1884 MQTT_WS_PORT=9002 for every process.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TOPIC=hydrogrow/telemetry
# Leave empty for an anonymous LAN-only broker; set both to enable auth (broker/mosquitto.conf).
MQTT_USER=
MQTT_PASS=
MQTT_CLIENT_ID=hydrogrow-pi
INGEST_CLIENT_ID=hydrogrow-ingest

# ---- Storage ----
# SQLite file shared by ingest and the backend. Default: local-edition/data/hydrogrow.db
#HYDROGROW_DB=/absolute/path/to/hydrogrow.db
# Firmware data root: models/, captures/, mqtt_queue/, state files. Default: the user's home.
#HYDROGROW_DATA_DIR=/absolute/path/to/data

# ---- Firmware (firmware/main.py) ----
# mqtt = Local Edition (this folder). azure = retired cloud edition.
HYDROGROW_TRANSPORT=mqtt
# Defaults reproduce the original 30-minute loop. setup.sh uses 30 / 1800 / 300 on the Pi.
SENSOR_INTERVAL_S=1800
DOSING_COOLDOWN_S=1800
CAMERA_INTERVAL_S=1800
# Day 1 of the grow, YYYY-MM-DD.
PLANTING_DATE=2026-06-01
# 1 = decide, log and publish dosing, never drive a relay. setup.sh starts the Pi with 1.
PUMPS_DRY_RUN=0

# ---- Backend (Express, serves the dashboard and the API) ----
PORT=8080
NODE_ENV=production
# Seeded on first start if no user with this email exists. Nothing is seeded while
# the password is empty. Choose your own; setup.sh asks for it on the Pi.
DEMO_USER_EMAIL=demo@hydrogrow.local
DEMO_USER_PASSWORD=
DEMO_USER_NAME=Demo
# Seconds before /health reports the last reading as stale.
HEALTH_STALE_AFTER_S=120

# ---- Optional: AI chat (fails gracefully when unset or offline) ----
HF_API_KEY=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
